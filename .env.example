# Local development. Set False in production.
DJANGO_DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Leave DATABASE_URL empty to use local SQLite.
# PostgreSQL example: postgres://user:password@localhost:5432/tsavo_hub
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob is used automatically when this token is present.
# Create a PUBLIC Blob store for website images; Vercel injects this value.
BLOB_READ_WRITE_TOKEN=

# Set only after a real public origin is assigned, for canonical URLs.
SITE_ORIGIN=

# Contact notifications use the console locally. Configure SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=web@localhost
CONTACT_NOTIFICATION_EMAIL=tiih@ttu.ac.ke
CONTACT_RATE_LIMIT=5

# Production security options.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Five megabytes.
MAX_IMAGE_UPLOAD_SIZE=5242880
